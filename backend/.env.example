DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require
JWT_SECRET_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_API_KEY=<YOUR_GOOGLE_GEMINI_API_KEY>
FRONTEND_ORIGIN=https://<your-static-web-app-hostname>
AZURE_STORAGE_CONNECTION_STRING=<YOUR_AZURE_STORAGE_CONNECTION_STRING>
AZURE_STORAGE_RESUME_CONTAINER=resumes
AZURE_STORAGE_RESUME_URL_TTL_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<SET_ADMIN_PASSWORD_FOR_SEEDING>
